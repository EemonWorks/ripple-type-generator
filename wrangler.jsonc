{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ripple-type-generator",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "eemonroy.com/rippletypegenerator*",
      "zone_name": "eemonroy.com"
    }
  ]
}
